    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
