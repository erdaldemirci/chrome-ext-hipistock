{
  "manifest_version": 3,
  "name": "Hipistock",
  "version": "1.0.1",
  "description": "Shopify ürün kataloğunu Hipicon satıcı paneline aktarır.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Hipistock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.myshopify.com/*",
    "https://admin.shopify.com/*",
    "https://accounts.shopify.com/*",
    "https://*.hipicon.com/*",
    "https://hipicon.com/*",
    "https://bo-api.hipicon.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.tcmb.gov.tr/*",
    "https://api.frankfurter.app/*",
    "https://open.er-api.com/*"
  ],
    "content_scripts": [
    {
      "matches": [
        "https://*.hipicon.com/*",
        "https://hipicon.com/*"
      ],
      "js": ["content/hipicon.js"],
      "run_at": "document_idle",
      "type": "module"
    },
    {
      "matches": [
        "https://admin.shopify.com/*"
      ],
      "js": ["content/shopify-admin.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "templates/*",
        "assets/*",
        "content/*"
      ],
      "matches": [
        "https://*.hipicon.com/*",
        "https://hipicon.com/*",
        "https://admin.shopify.com/*"
      ]
    }
  ]
}
